BASH_EXEC_IGNORE_LIBRARIES=true
ENABLE_GITHUB_ACTIONS_GROUP_TITLE=true
# The skills synced from the claude.ai account are third-party files and are
# gitignored: keep them out of the linters.
IGNORE_GITIGNORED_FILES=true
