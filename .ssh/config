# Per-machine host blocks (which key authenticates to which host, agent
# forwarding) live outside the repository in ~/.ssh/config.d/. They come
# first because ssh keeps the first value set for each option, so local
# blocks win over the generic ones below.
Include config.d/*

# Load a key into the agent on first use, so no manual ssh-add is needed, but
# only on the machine that owns the agent: on a remote host SSH_AUTH_SOCK is
# the agent forwarded from the client, and the key would be sent there.
# ${SSH_CONNECTION:+set} expands to nothing locally and to "set" over SSH.
Match exec "test -z ${SSH_CONNECTION:+set}"
  AddKeysToAgent yes

Host *
  # UseKeychain exists only on macOS; other platforms must skip it
  IgnoreUnknown UseKeychain
  UseKeychain yes
